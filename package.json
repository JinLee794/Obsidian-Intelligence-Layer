{
  "name": "@jinlee794/obsidian-intelligence-layer",
  "version": "0.6.0",
  "description": "Obsidian Intelligence Layer — Knowledge Layer MCP Server for AI Agent Workflows",
  "type": "module",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JinLee794/Obsidian-Intelligence-Layer.git"
  },
  "main": "dist/index.js",
  "bin": {
    "obsidian-intelligence-layer": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "prepare": "npm run build",
    "prepublishOnly": "npm run check:release",
    "test": "vitest run",
    "test:perf": "vitest run src/__tests__/perf-regression.test.ts",
    "test:package": "node scripts/package-smoke.mjs",
    "test:ux": "node scripts/consumer-ux-check.mjs",
    "check:release": "npm run lint && npm test && npm run test:package",
    "lint": "tsc --noEmit -p tsconfig.check.json",
    "bench": "vitest bench",
    "bench:watch": "vitest bench --watch",
    "bench:baseline": "bash scripts/bench-check.sh --update",
    "bench:check": "bash scripts/bench-check.sh",
    "eval": "node bench/eval-golden.mjs --dataset=bench/datasets/fixture.golden.json",
    "eval:baseline": "node bench/eval-golden.mjs --dataset=bench/datasets/fixture.golden.json --baseline",
    "eval:check": "node bench/eval-golden.mjs --dataset=bench/datasets/fixture.golden.json --compare",
    "eval:lexical": "node bench/eval-golden.mjs --dataset=bench/datasets/fixture.golden.json --no-semantic --compare",
    "eval:strategies": "node bench/ranking-strategies.mjs"
  },
  "keywords": [
    "mcp",
    "obsidian",
    "knowledge-layer",
    "ai-agent"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "chokidar": "^4.0.3",
    "fuse.js": "^7.1.0",
    "gray-matter": "^4.0.3",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@vitest/runner": "^4.0.18",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
