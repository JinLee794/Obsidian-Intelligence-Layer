{
  "mcpServers": {
    "oil": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${PLUGIN_ROOT}/bin/oil-mcp.mjs",
        "--package=@mcaps-microsoft/obsidian-intelligence-layer@0.9.4",
        "mcp"
      ],
      "env": {
        "OBSIDIAN_VAULT_PATH": "${OBSIDIAN_VAULT_PATH}"
      },
      "tools": ["*"]
    }
  }
}
