{
  "name": "@jinlee794/obsidian-intelligence-layer",
  "version": "0.6.0",
  "description": "Obsidian Intelligence Layer — Knowledge Layer MCP Server for AI Agent Workflows",
  "type": "module",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/JinLee794/Obsidian-Intelligence-Layer.git"
  },
  "main": "dist/index.js",
  "bin": {
    "oil": "dist/cli.js",
    "obsidian-intelligence-layer": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    ".github/skills/oil-retrieval"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js mcp",
    "prepublishOnly": "tsc",
    "prepare": "npm run build",
    "lint": "tsc --noEmit",
    "test:setup": "vitest run vault-path --pool=threads",
    "test:catalog": "vitest run catalog-contract spec-contract --pool=threads",
    "test:vault:live": "node scripts/run-live-vault-audit.mjs",
    "test:vault:crud": "node scripts/run-live-vault-crud.mjs",
    "bench": "vitest bench --run",
    "bench:watch": "vitest bench --watch",
    "bench:baseline": "bash scripts/bench-check.sh --update",
    "bench:check": "bash scripts/bench-check.sh"
  },
  "keywords": [
    "mcp",
    "obsidian",
    "knowledge-layer",
    "ai-agent"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "chokidar": "^4.0.3",
    "fuse.js": "^7.1.0",
    "gray-matter": "^4.0.3",
    "yaml": "^2.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.0",
    "@vitest/runner": "^4.0.18",
    "typescript": "^5.7.3",
    "vitest": "^4.0.18"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
