// Merge bench/sharding/results-<size>.json into results.json, compute the
// verdict and crossover, count LOC, and refresh the marked block in REPORT.md.
//
//   node bench/sharding/aggregate.mts
import { readdir, readFile, writeFile } from "node:fs/promises";
import { join, dirname } from "node:path";
import { fileURLToPath } from "node:url";

const HERE = dirname(fileURLToPath(import.meta.url));
const START = "<!-- tables:start -->";
const END = "<!-- tables:end -->";

// GO thresholds from the brief.
const MIN_SIZE = 5000;
const WARM_GAIN = 0.3;
const FLUSH_GAIN = 0.5;
const MIN_JACCARD = 0.9;
const PRIMARY = "S1b+reval";

const files = (await readdir(HERE)).filter((f) => /^results-\d+\.json$/.test(f));
const runs: any[] = [];
for (const f of files) runs.push(JSON.parse(await readFile(join(HERE, f), "utf-8")));
runs.sort((a, b) => a.size - b.size);
if (runs.length === 0) {
  console.error("no results-<size>.json files; run harness.mts first");
  process.exit(1);
}

async function loc(file: string): Promise<number> {
  const text = await readFile(join(HERE, file), "utf-8");
  let n = 0, inBlock = false;
  for (const raw of text.split("\n")) {
    const line = raw.trim();
    if (inBlock) {
      if (line.includes("*/")) inBlock = false;
      continue;
    }
    if (line === "" || line.startsWith("//")) continue;
    if (line.startsWith("/*")) {
      if (!line.includes("*/")) inBlock = true;
      continue;
    }
    n++;
  }
  return n;
}

const kb = (b: number) => (b >= 1 << 20 ? `${(b / (1 << 20)).toFixed(2)} MB` : `${(b / 1024).toFixed(1)} KB`);
const ms = (x: number) => (Number.isFinite(x) ? (x >= 100 ? x.toFixed(0) : x.toFixed(1)) : "–");
const pc = (x: number) => (Number.isFinite(x) ? `${(x * 100).toFixed(1)}%` : "–");
const fx = (x: number, d = 3) => (Number.isFinite(x) ? x.toFixed(d) : "–");
const table = (head: string[], rows: (string | number)[][]) =>
  [`| ${head.join(" | ")} |`, `|${head.map(() => "---").join("|")}|`, ...rows.map((r) => `| ${r.join(" | ")} |`)].join("\n");

// ── per-size assessment ─────────────────────────────────────────────────────
function linkOk(r: any, v: string): boolean {
  const p = r.parity ?? {};
  const checks = [p.coldLinks?.[v], p.warmLinks?.[v], p.afterEditLinks?.[v], p.afterMassLinks?.[v]].filter(Boolean);
  return checks.length > 0 && checks.every((c: any) => c.rate === 1);
}
function minJaccard(r: any, v: string): number {
  const p = r.parity ?? {};
  const xs = [p.coldSearch?.[v], p.warmSearch?.[v], p.afterEditSearch?.[v], p.afterMassSearch?.[v]]
    .filter(Boolean)
    .map((s: any) => s.meanJaccard);
  return xs.length ? Math.min(...xs) : NaN;
}
function assess(r: any, v: "B" | "B2") {
  const wa = r.warmFirstAnswer?.[PRIMARY]?.A?.total?.median;
  const wb = r.warmFirstAnswer?.[PRIMARY]?.[v]?.total?.median;
  const fa = r.singleEdit?.A?.all?.medianBytes;
  const fb = r.singleEdit?.[v]?.all?.medianBytes;
  const warmGain = 1 - wb / wa;
  const flushGain = 1 - fb / fa;
  const links = linkOk(r, v);
  const jac = minJaccard(r, v);
  const parity = links && jac >= MIN_JACCARD;
  const threshold = warmGain >= WARM_GAIN || flushGain >= FLUSH_GAIN;
  return { size: r.size, warmGain, flushGain, links, minJaccard: jac, parity, threshold, pays: parity && threshold };
}

const verdicts: Record<string, any> = {};
for (const v of ["B", "B2"] as const) {
  const per = runs.map((r) => assess(r, v));
  const big = per.filter((x) => x.size >= MIN_SIZE);
  const go = big.length > 0 && big.every((x) => x.pays);
  // Crossover: smallest tested size from which every larger tested size pays off.
  let crossover: number | null = null;
  for (let i = per.length - 1; i >= 0 && per[i].pays; i--) crossover = per[i].size;
  const realSize = per.find((x) => x.size >= 1300 && x.size <= 1500) ?? null;
  verdicts[v] = { go, crossover, atRealVaultSize: realSize, perSize: per };
}
const overall = verdicts.B.go || verdicts.B2.go ? "GO" : "NO-GO";

const locs = {
  "segmented.mts (B, B2)": await loc("segmented.mts"),
  "independent.mts (C)": await loc("independent.mts"),
  "harness.mts": await loc("harness.mts"),
  "fixtures.mts": await loc("fixtures.mts"),
};

// ── tables ──────────────────────────────────────────────────────────────────
const V = ["A", "B", "B2"];
const out: string[] = [];
out.push(`_Generated by aggregate.mts at ${new Date().toISOString()} from ${files.join(", ")}. Node ${runs[0].node}, ${runs[0].platform}._`);

out.push("\n### Verdict\n");
out.push(`**${overall}** (primary warm metric: \`${PRIMARY}\` = load + stat revalidation + first customer-scoped search).\n`);
out.push(table(
  ["variant", "size", "warm-first gain", "flush-bytes gain", "link parity", "min mean top-10 Jaccard", "pays off"],
  ["B", "B2"].flatMap((v) => verdicts[v].perSize.map((x: any) => [v, x.size, pc(x.warmGain), pc(x.flushGain), x.links ? "100%" : "**FAIL**", fx(x.minJaccard), x.pays ? "yes" : "no"])),
));
for (const v of ["B", "B2"]) {
  const r = verdicts[v];
  out.push(`\n- ${v}: ${r.go ? "GO" : "NO-GO"} at ≥${MIN_SIZE} notes; crossover ${r.crossover ?? "none in tested range"}; at ~1.4k: ${r.atRealVaultSize ? (r.atRealVaultSize.pays ? "pays off" : "does not pay off") : "not tested"}.`);
}

out.push("\n### Cold build and persisted size (median ms)\n");
out.push(table(
  ["notes", "A build+save", "B build+save", "B2 build+save", "C build", "A bytes", "B total", "B skeleton", "B stats", "B largest seg", "B2 largest seg", "B/B2 segments"],
  runs.map((r) => {
    const c = r.coldBuild, p = r.persistedBytes;
    return [r.size, ms(c.A.total.median), ms(c.B.total.median), ms(c.B2.total.median), ms(c.C.build.median),
      kb(p.A.total), kb(p.B.total), kb(p.B.skeleton), kb(p.B.stats), `${kb(p.B.largestSegment)} (${p.B.largestSegmentFile})`,
      `${kb(p.B2.largestSegment)} (${p.B2.largestSegmentFile})`, `${p.B.segments}/${p.B2.segments}`];
  }),
));

out.push("\n### Warm load to first answer (median total ms; p95 in parentheses; segments loaded)\n");
for (const id of ["S1a", "S1b", "S1b+reval", "S4", "S5"]) {
  out.push(`\n**${id}**\n`);
  out.push(table(
    ["notes", ...V.map((v) => `${v} total`), "A load / query", "B load / query", "B2 load / query", "B segs", "B2 segs"],
    runs.map((r) => {
      const w = r.warmFirstAnswer[id];
      return [r.size, ...V.map((v) => `${ms(w[v].total.median)} (${ms(w[v].total.p95)})`),
        ...V.map((v) => `${ms(w[v].load.median)} / ${ms(w[v].query.median)}`),
        `${w.B.segmentsLoaded}/${r.warmFirstAnswer.segmentsTotal?.B ?? "?"}`, `${w.B2.segmentsLoaded}/${r.warmFirstAnswer.segmentsTotal?.B2 ?? "?"}`];
    }),
  ));
}

out.push("\n### Single-note edit → flush\n");
out.push(table(
  ["notes", "variant", "median bytes", "mean bytes", "max bytes", "flush ms p50 (p95)", "longest event-loop block p50 (p95)", "longest JSON.stringify p50"],
  runs.flatMap((r) => V.map((v) => {
    const e = r.singleEdit[v].all;
    return [r.size, v, kb(e.medianBytes), kb(e.meanBytes), kb(e.maxBytes), `${ms(e.flushMs.median)} (${ms(e.flushMs.p95)})`,
      `${ms(e.elMaxMs.median)} (${ms(e.elMaxMs.p95)})`, ms(e.stringifyMaxMs.median)];
  })),
));
out.push("\nMedian flush bytes by edited note's folder:\n");
const folders = [...new Set(runs.flatMap((r) => Object.keys(r.singleEdit.A.byFolder)))].sort();
out.push(table(
  ["notes", "variant", ...folders],
  runs.flatMap((r) => V.map((v) => [r.size, v, ...folders.map((f) => (r.singleEdit[v].byFolder[f] ? kb(r.singleEdit[v].byFolder[f].medianBytes) : "–"))])),
));

out.push("\n### Mass invalidation (30% of mtimes touched, then revalidate)\n");
out.push(table(
  ["notes", "variant", "touched", "bytes written (median)", "wall ms", "saves", "segments loaded", "longest event-loop block"],
  runs.flatMap((r) => V.map((v) => {
    const m = r.massInvalidation[v];
    return [r.size, v, m.touched, kb(m.bytes.median), ms(m.ms.median), m.saves, m.segmentsLoaded, ms(m.elMaxMs.median)];
  })),
));

out.push("\n### Heap used (MB above baseline, median)\n");
out.push(table(
  ["notes", ...V.flatMap((v) => [`${v} after load`, `${v} after S1b`, `${v} after S5`])],
  runs.map((r) => (typeof r.heapBytes === "string"
    ? [r.size, ...V.flatMap(() => ["–", "–", "–"])]
    : [r.size, ...V.flatMap((v) => ["afterLoad", "afterS1b", "afterS5"].map((k) => fx(r.heapBytes[v][k] / (1 << 20), 1)))])),
));

out.push("\n### Steady-state query latency, ms p50 / p95\n");
out.push(table(
  ["notes", "query", ...V],
  runs.flatMap((r) => Object.entries(r.steadyQueryMs).map(([q, per]: [string, any]) => [r.size, q, ...V.map((v) => `${ms(per[v].p50)} / ${ms(per[v].p95)}`)])),
));

out.push("\n### Parity versus A\n");
out.push(table(
  ["notes", "variant", "links cold / warm / edit / mass", "mean Jaccard cold / warm / edit / mass", "exact rank+score rate (cold)", "customer context equal"],
  runs.flatMap((r) => ["B", "B2"].map((v) => {
    const p = r.parity;
    const l = [p.coldLinks?.[v], p.warmLinks?.[v], p.afterEditLinks?.[v], p.afterMassLinks?.[v]].map((x: any) => (x ? pc(x.rate) : "–")).join(" / ");
    const j = [p.coldSearch?.[v], p.warmSearch?.[v], p.afterEditSearch?.[v], p.afterMassSearch?.[v]].map((x: any) => (x ? fx(x.meanJaccard) : "–")).join(" / ");
    const ctx = p.coldContext?.[v];
    return [r.size, v, l, j, pc(p.coldSearch?.[v]?.exactRate), ctx ? `${ctx.equal}/${ctx.customers}` : "–"];
  })),
));
out.push(`\nSearch parity covers ${runs[0].parity?.coldSearch?.B?.queries ?? "?"} queries per check: the fixture's global queries (entity names, aliases, frontmatter IDs, body phrases) plus customer-scoped and folder-filtered variants.`);

out.push("\n### Variant C drift (independent per-folder graphs)\n");
out.push(table(
  ["notes", "link-set equality", "fwd mismatches", "back mismatches", "mean top-10 Jaccard", "exact rate", "cross-folder edges", "unresolved after edge table", "broken in A"],
  runs.map((r) => {
    const d = r.driftC;
    return [r.size, pc(d.links.rate), d.links.fwdMismatch, d.links.backMismatch, fx(d.search.meanJaccard), pc(d.search.exactRate), d.crossEdges, d.unresolvedAfterCross, d.brokenInA];
  }),
));

out.push("\n### Implementation size (non-blank, non-comment lines)\n");
out.push(table(["file", "LOC"], Object.entries(locs).map(([f, n]) => [f, n])));

const accounting = runs.filter((r) => r.writeAccountingCheck && !r.writeAccountingCheck.ok).map((r) => r.size);
if (accounting.length) {
  out.push(`\n> **Warning:** write accounting self-check failed at ${accounting.join(", ")}; use the \`changedBytes\` fields in results.json instead of \`bytes\`.`);
}

const md = out.join("\n");
await writeFile(
  join(HERE, "results.json"),
  JSON.stringify({ status: "measured", generatedAt: new Date().toISOString(), verdict: overall, thresholds: { MIN_SIZE, WARM_GAIN, FLUSH_GAIN, MIN_JACCARD, PRIMARY }, verdicts, loc: locs, sizes: runs }, null, 2),
);
const reportPath = join(HERE, "REPORT.md");
const report = await readFile(reportPath, "utf-8");
const a = report.indexOf(START), b = report.indexOf(END);
if (a >= 0 && b > a) {
  await writeFile(reportPath, `${report.slice(0, a + START.length)}\n${md}\n${report.slice(b)}`);
  console.log(`updated REPORT.md and results.json; verdict ${overall}`);
} else {
  console.log(md);
}
